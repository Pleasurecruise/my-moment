                        "r2Key",
                        "thumbnailR2Key",
                        "title",
                        "width",
                        "height",
                        "tags",
                        "updatedAt"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": ["photo"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
