    },
    "/tags": {
      "get": {
        "summary": "List tags with photo counts",
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "description": "Tags, most used first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "count": {
                            "type": "integer"
                          }
                        },
                        "required": ["name", "count"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["tags"]
                }
              }
            }
          }
        }
      }
