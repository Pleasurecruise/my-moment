{
  "name": "my-moment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @my-moment/app dev",
    "build": "pnpm --filter @my-moment/app build",
    "deploy": "pnpm --filter @my-moment/app exec void deploy",
    "test": "pnpm --filter @my-moment/app test",
    "storybook": "pnpm --filter @my-moment/ui storybook",
    "storybook:build": "pnpm --filter @my-moment/ui storybook:build",
    "d1:migrate:local": "wrangler d1 migrations apply DB --cwd apps/moment --local --persist-to .void --config wrangler.json",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --cwd apps/moment --remote --config wrangler.json",
    "check": "pnpm --filter @my-moment/app prepare && vp check && pnpm typecheck",
    "typecheck": "tsc --noEmit -p apps/moment/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json",
    "lint": "vp lint",
    "format": "vp fmt"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.2",
    "solid-js": "1.9.14",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite-plugin-solid": "2.11.14",
    "vite-plus": "0.2.8",
    "wrangler": "4.120.0"
  },
  "packageManager": "pnpm@11.20.0"
}
