{
  "name": "my-moment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @my-moment/app dev",
    "build": "pnpm --filter @my-moment/app build",
    "deploy": "pnpm --filter @my-moment/app exec void deploy --platform cloudflare",
    "test": "pnpm --filter @my-moment/app test",
    "storybook": "pnpm --filter @my-moment/ui storybook",
    "storybook:build": "pnpm --filter @my-moment/ui storybook:build",
    "d1:migrate:local": "pnpm --filter @my-moment/app exec void db migrate",
    "d1:migrate:remote": "pnpm --filter @my-moment/app exec void db migrate --remote",
    "check": "pnpm --filter @my-moment/app prepare && vp check && pnpm typecheck",
    "typecheck": "tsc --noEmit -p apps/moment/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json",
    "lint": "vp lint",
    "format": "vp fmt"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-rc.14",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "solid-js": "2.0.0-rc.14",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite-plugin-solid": "3.0.0-next.27",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@12.10.1"
}
